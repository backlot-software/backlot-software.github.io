---
import Search from '@astrojs/starlight/components/Search.astro';
import Sidebar from '@astrojs/starlight/components/Sidebar.astro';
import SearchFilters from './search/SearchFilters.astro';

const isSearchPage = Astro.locals.starlightRoute.id === 'search';
---

{isSearchPage ? (
  <>
    <SearchFilters />
    <style is:inline>
      .sidebar-content {
        border-right: 1px solid var(--color-border);
      }
    </style>
  </>
) : (
  <>
    <Search />
    <Sidebar />
  </>
)}
