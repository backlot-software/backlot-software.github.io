---
import MobileMenuFooter from '@astrojs/starlight/components/MobileMenuFooter.astro';

interface FilterOption {
  value: string;
  label: string;
  count?: number;
  checked?: boolean;
}

interface FilterGroup {
  name: string;
  label: string;
  options: FilterOption[];
}

// Placeholder filters until the search is connected to NousAI.
const groups: FilterGroup[] = [
  {
    name: 'section',
    label: 'Section',
    options: [
      { value: 'introduction', label: 'Introduction', count: 5 },
      { value: 'concepts', label: 'Concepts', count: 9, checked: true },
      { value: 'principals', label: 'Principals', count: 7 },
      { value: 'conventions', label: 'Conventions', count: 2 }
    ]
  },
  {
    name: 'integration',
    label: 'Integration',
    options: [
      { value: 'azure-functions', label: 'Azure Functions' },
      { value: 'autofac', label: 'Autofac' },
      { value: 'ravendb', label: 'RavenDB' },
      { value: 'serilog', label: 'Serilog' }
    ]
  }
];
---

<form class="flex flex-col gap-6 pt-4 md:pt-6" aria-labelledby="search-filters-title">
  <h2 id="search-filters-title" class="m-0 text-base font-bold text-fg">
    Search Filters
  </h2>
  {groups.map(({ name, label, options }) => (
    <fieldset class="m-0 flex flex-col gap-1 p-0">
      <legend class="mb-2 p-0 text-xs font-semibold text-muted">{label}</legend>
      {options.map(({ value, label, count, checked }) => (
        <label class="flex cursor-pointer items-center gap-2.5 rounded-sm py-1 text-sm text-fg transition-all hover:text-brand">
          <input class="m-0 size-4 flex-none cursor-pointer accent-brand" type="checkbox" {name} {value} {checked} />
          <span class="flex-1">{label}</span>
          {count !== undefined && <span class="text-xs text-muted tabular-nums">{count}</span>}
        </label>
      ))}
    </fieldset>
  ))}
</form>

<div class="mt-auto md:hidden">
  <MobileMenuFooter />
</div>
