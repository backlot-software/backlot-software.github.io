---
import MobileMenuFooter from '@astrojs/starlight/components/MobileMenuFooter.astro';
---

<form class="flex flex-col gap-6 pt-4 md:pt-6" aria-labelledby="search-filters-title" data-search-filters>
  <h2 id="search-filters-title" class="m-0 text-base font-bold text-fg">
    Search Filters
  </h2>
  <!-- Options are rendered on the search page from the sections Pagefind finds in the current results. -->
  <fieldset class="m-0 flex flex-col gap-1 p-0" hidden data-filter-group="section">
    <legend class="mb-2 p-0 text-xs font-semibold text-muted">Section</legend>
    <div class="contents" data-filter-options></div>
    <template data-filter-option-template>
      <label class="flex cursor-pointer items-center gap-2.5 rounded-sm py-1 text-sm text-fg transition-all hover:text-brand">
        <input class="m-0 size-4 flex-none cursor-pointer accent-brand" type="checkbox" name="section" />
        <span class="flex-1" data-filter-label></span>
        <span class="text-xs text-muted tabular-nums" data-filter-count></span>
      </label>
    </template>
  </fieldset>
</form>

<div class="mt-auto md:hidden">
  <MobileMenuFooter />
</div>
