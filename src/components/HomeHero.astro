---
import HomeSearch from './HomeSearch.astro';

const pills = [
  {
    label: 'Getting started',
    href: '/introduction/getting-started/'
  },
  {
    label: 'Actors',
    href: '/concepts/actor/'
  },
  {
    label: 'Scenarios',
    href: '/concepts/scenarios/'
  },
  {
    label: 'Search',
    href: '/concepts/search/'
  }
];
---

<section class="mx-auto mt-[100%] w-2xl px-4 font-display sm:mt-[20%] sm:px-0" aria-labelledby="_top">
  <h1 id="_top" class="m-0 text-center leading-tight font-medium text-fg">
    Build with <span class="font-bold tracking-tight text-brand">Backlot</span>
  </h1>
  <p class="mt-2.5 mb-8 text-center text-lg leading-snug text-muted">
    Everything you need to understand and build with the Backlot framework.
  </p>
  <HomeSearch />
  <nav class="mt-3 flex flex-wrap items-center gap-2 text-sm text-muted" aria-label="Popular documentation">
    <span>Popular:</span>
    {pills.map(({ label, href }) => (
      <a
        class="rounded-full border border-border bg-card px-3 py-0.5 text-muted no-underline transition-all interact:border-brand interact:text-fg"
        {href}>
        {label}
      </a>
    ))}
  </nav>
</section>
