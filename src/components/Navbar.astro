---
import SocialIcons from '@astrojs/starlight/components/SocialIcons.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';

const links = [
  { label: 'Docs', href: '/introduction/' },
  { label: 'Concepts', href: '/concepts/actor/' },
  { label: 'Guides', href: '/introduction/getting-started/' }
];
---

<div class="mx-auto flex h-full max-w-7xl items-center justify-between px-6">
  <div class="flex items-center gap-2">
    <a
      href="/"
      class="flex items-center gap-2 font-display text-[15px] font-bold tracking-tight text-fg no-underline visited:text-inherit">
      <img src="/assets/bl.png" alt="Backlot Logo" class="size-7" />
      <span>Backlot</span>
    </a>
  </div>
  <nav aria-label="Main navigation" class="hidden items-center gap-7 text-[13px] text-muted md:flex">
    {links.map(({ label, href }) => (
      <a
        {href}
        aria-current={Astro.url.pathname === href ? 'page' : undefined}
        class="no-underline transition-all visited:text-inherit hover:text-fg aria-[current=page]:text-fg">
        {label}
      </a>
    ))}
  </nav>
  <div class="flex items-center justify-end gap-2">
    <div class="max-md:hidden">
      <SocialIcons />
    </div>
    <ThemeSelect />
  </div>
</div>
