---
import MobileMenuFooter from '@astrojs/starlight/components/MobileMenuFooter.astro';
import MessageCircleIcon from '@lucide/astro/icons/message-circle';
import PlusIcon from '@lucide/astro/icons/plus';

// Placeholder conversations until the chat is connected to NousAI.
const conversations = [
  { title: 'Logging scenario events', active: true },
  { title: 'Registering a BingeWatcher' },
  { title: 'Configuring the Director' },
  { title: 'Persisted Role Repository setup' },
  { title: 'GET vs. POST scenarios' }
];
---

<div class="flex flex-col gap-8 pt-4 md:pt-6">
  <button
    type="button"
    class="flex w-full cursor-pointer items-center gap-1.5 rounded-md border-0 bg-brand px-4 py-2.5 text-sm font-semibold text-white transition-all interact:bg-accent-600">
    <PlusIcon class="size-4" aria-hidden="true" />
    New Conversation
  </button>

  <nav class="flex flex-col gap-3" aria-labelledby="recent-conversations-title">
    <h2 id="recent-conversations-title" class="m-0 text-xs font-semibold text-muted">
      Recent Conversations
    </h2>
    <div class="m-0 flex list-none flex-col gap-2 p-0">
      {conversations.map(({ title, active }) => (
        <a
          role="button"
          aria-current={active ? 'page' : undefined}
          href="#"
          class="flex w-full cursor-pointer items-center gap-3 rounded-md border-0 bg-transparent px-3 py-2.5 text-left text-sm text-fg no-underline transition-all visited:text-fg aria-[current=page]:bg-card interact:text-brand">
          <MessageCircleIcon class="size-4 flex-none" aria-hidden="true" />
          <span class="truncate">{title}</span>
        </a>
      ))}
    </div>
  </nav>
</div>

<div class="mt-auto md:hidden">
  <MobileMenuFooter />
</div>
