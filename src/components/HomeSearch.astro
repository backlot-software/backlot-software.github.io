---
import ArrowRightIcon from '@lucide/astro/icons/arrow-right';
import SearchIcon from '@lucide/astro/icons/search';

interface Props {
  /** Smaller variant with a keyboard shortcut hint, used on the search results page. */
  compact?: boolean;
  class?: string;
}

const { compact = false, class: className } = Astro.props;
---

<form
  action="/search/"
  method="get"
  class:list={[
    'flex w-full items-center gap-2.5 rounded-lg border border-border bg-card px-3.5 text-muted transition-all focus-within:border-brand interact:border-brand',
    compact ? 'py-1' : 'py-3.5',
    className
  ]}
  role="search"
  data-home-search>
  <SearchIcon
    class="size-5 flex-none stroke-current stroke-2 [stroke-linecap:round] [stroke-linejoin:round]"
    aria-hidden="true"
  />
  <input
    class="min-w-0 flex-1 appearance-none border-0 bg-transparent p-0 text-fg outline-none [font:inherit] placeholder:text-muted"
    type="search"
    name="query"
    aria-label="Search Backlot documentation"
    placeholder="Ask Backlot anything..."
    required
  />

  {compact && (
    <kbd class="hidden flex-none font-sans text-xs text-muted sm:block" aria-label="Command K">
      &#8984; K
    </kbd>
  )}

  <button
    class="flex size-8 flex-none cursor-pointer items-center justify-center rounded-sm border-0 bg-transparent p-0 text-fg interact:text-brand"
    type="submit"
    aria-label="Search">
    <ArrowRightIcon
      class="size-5 flex-none stroke-current stroke-2 [stroke-linecap:round] [stroke-linejoin:round]"
      aria-hidden="true"
    />
  </button>
</form>
